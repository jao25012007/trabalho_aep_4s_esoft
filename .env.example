# Copie para .env e preencha os dados do PostgreSQL do SEU projeto Supabase.
# Obtenha host, usuário e porta no painel Connect > Session pooler.
# Substitua os exemplos pelos valores completos do painel. Senha de banco, não a API key.
DB_URL=jdbc:postgresql://SEU_HOST:5432/postgres?sslmode=require
DB_USER=postgres.SEU_PROJECT_REF
DB_PASSWORD=COLOQUE_A_SENHA_DO_BANCO
# PostgreSQL local, como alternativa para desenvolvimento:
# DB_URL=jdbc:postgresql://localhost:5432/educaplan
# DB_USER=postgres
